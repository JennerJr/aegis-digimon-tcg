{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../src/*"],
      "@e2e/*": ["./*"],
      "@api-fixtures/*": ["../../api/src/engine/scenarios/*"]
    },
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["./*.ts", "./*.tsx"]
}
